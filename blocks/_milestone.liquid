<div class="milestone reveal" role="listitem" {{ block.shopify_attributes }}>
  <p class="milestone__date">{{ block.settings.date | escape }}</p>
  <span class="milestone__dot" aria-hidden="true"></span>
  <div class="milestone__body">
    <h3>{{ block.settings.title | escape }}</h3>
    {%- if block.settings.text != blank -%}
      <div class="milestone__text rte">{{ block.settings.text }}</div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .milestone {
    display: grid;
    grid-template-columns: 136px 48px minmax(0, 1fr);
    align-items: start;
    padding-block: 20px;
  }

  .milestone__date {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--color-foreground);
  }

  .milestone__dot {
    justify-self: center;
    width: 11px;
    height: 11px;
    margin-top: 9px;
    border-radius: 50%;
    background: #efe6fa;
    box-shadow: 0 0 0 4px rgba(var(--color-accent-rgb), 0.35), 0 0 14px 3px rgba(var(--color-accent-light-rgb), 0.8);
  }

  .milestone__body {
    display: grid;
    gap: 8px;
    max-width: 62ch;
  }

  .milestone__body h3 {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .milestone__text {
    color: var(--color-muted);
  }

  @media (max-width: 760px) {
    .milestone {
      grid-template-columns: 16px minmax(0, 1fr);
      column-gap: 18px;
      row-gap: 6px;
    }

    .milestone__dot {
      grid-row: 1;
      grid-column: 1;
      margin-top: 6px;
      justify-self: start;
      width: 15px;
      height: 15px;
    }

    .milestone__date {
      grid-column: 2;
      font-size: 1.4rem;
    }

    .milestone__body {
      grid-column: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.milestone",
  "settings": [
    {
      "type": "text",
      "id": "date",
      "label": "t:labels.date",
      "default": "2024"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.title",
      "default": "Milestone"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Describe what happened.</p>"
    }
  ],
  "presets": [{ "name": "t:names.milestone" }]
}
{% endschema %}
