<div class="trust-item reveal" {{ block.shopify_attributes }}>
  <div class="trust-item__hex">
    {%- render 'icon', name: 'hex' -%}
    <span>{{ block.settings.badge | escape }}</span>
  </div>
  <p>{{ block.settings.label | escape }}</p>
</div>

{% stylesheet %}
  .trust-item {
    display: grid;
    justify-items: center;
    gap: 14px;
    text-align: center;
    padding: 12px 4px;
  }

  .trust-item__hex {
    position: relative;
    display: grid;
    place-items: center;
    width: 80px;
    height: 80px;
  }

  .trust-item__hex svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 0 12px rgba(var(--color-accent-rgb), 0.6));
    transition: filter 0.4s;
  }

  .trust-item__hex path {
    stroke-dasharray: 240;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.6s cubic-bezier(0.4, 0, 0.2, 1) 0.2s;
  }

  .js .trust-item.reveal:not(.is-visible) .trust-item__hex path {
    stroke-dashoffset: 240;
  }

  .trust-item:hover svg {
    filter: drop-shadow(0 0 18px rgba(var(--color-accent-light-rgb), 0.9));
  }

  .trust-item__hex span {
    position: relative;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #efe6fa;
  }

  .trust-item p {
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.8;
  }

  @media (max-width: 460px) {
    .trust-item__hex {
      width: 64px;
      height: 64px;
    }

    .trust-item p {
      font-size: 0.72rem;
      letter-spacing: 0.1em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.trust_item",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "t:labels.badge",
      "default": "GMP"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:labels.text",
      "default": "GMP certified"
    }
  ],
  "presets": [{ "name": "t:names.trust_item" }]
}
{% endschema %}
