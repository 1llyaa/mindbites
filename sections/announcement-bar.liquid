<div class="announcement full-width">
  <div class="announcement__inner">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}
      <p>{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .announcement {
    position: relative;
    background: linear-gradient(90deg, transparent, rgba(var(--color-accent-rgb), 0.35), transparent), var(--color-background);
    border-bottom: 1px solid rgba(var(--color-accent-rgb), 0.2);
  }

  .announcement__inner {
    display: grid;
    place-items: center;
    min-height: 34px;
    padding: 6px var(--gutter);
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #d9d6e2;
  }

  .announcement__inner a {
    color: inherit;
    text-decoration: none;
  }

  .announcement__inner a:hover {
    color: #fff;
  }

  .announcement strong,
  .announcement b {
    color: #fff;
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "Free EU shipping on orders over <b>2 pouches</b>"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [{ "name": "t:names.announcement_bar" }]
}
{% endschema %}
