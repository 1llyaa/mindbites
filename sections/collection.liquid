{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<div class="section section--page-top collection-page">
  {%- liquid
    assign lead = collection.description
    if lead == blank
      assign lead = section.settings.fallback_text
    endif
  -%}
  {%- render 'section-heading',
    eyebrow: section.settings.eyebrow,
    heading_heavy: collection.title,
    lead: lead,
    layout: 'split',
    tag: 'h1'
  -%}

  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="product-grid">
      {%- for product in collection.products -%}
        {%- render 'product-card', product: product, heading_tag: 'h2' -%}
      {%- else -%}
        <div class="empty-state">
          <p class="spaced">{{ 'collections.empty' | t }}</p>
          <a class="btn" href="{{ routes.root_url }}">
            {{- '404.back_to_shopping' | t -}}
            <span class="ar">{% render 'icon', name: 'arrow' %}</span>
          </a>
        </div>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Shop"
    },
    {
      "type": "richtext",
      "id": "fallback_text",
      "label": "t:labels.fallback_text",
      "default": "<p>Microdosed nootropic gummies. One pouch, three intensities.</p>"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:labels.products_per_page",
      "min": 6,
      "max": 48,
      "step": 3,
      "default": 24
    }
  ]
}
{% endschema %}
