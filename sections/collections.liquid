{% comment %}
  This section is used in the list-collections template to render a list of
  collections.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<div class="section section--page-top">
  {%- render 'section-heading',
    eyebrow: section.settings.eyebrow,
    heading_heavy: section.settings.heading,
    tag: 'h1'
  -%}

  <div class="collections" style="--grid-gap: {{ section.settings.grid_gap }}px">
    {%- for collection in collections -%}
      <a class="collection-card gcard reveal" href="{{ collection.url }}">
        <div class="collection-card__media">
          {%- if collection.featured_image -%}
            {{
              collection.featured_image
              | image_url: width: 800
              | image_tag: widths: '400, 600, 800', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', alt: ''
            }}
          {%- else -%}
            <img src="{{ 'mb-hero-pouch.webp' | asset_url }}" alt="" width="1600" height="2000" loading="lazy">
          {%- endif -%}
        </div>
        <div class="collection-card__content">
          <h2>{{ collection.title | escape }}</h2>
          <span class="collection-card__count">
            {{- 'collections.product_count' | t: count: collection.products_count -}}
          </span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .collections {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: var(--grid-gap);
  }

  .collection-card {
    display: grid;
    text-decoration: none;
  }

  .collection-card__media {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    padding: 28px;
    background: radial-gradient(circle at 50% 45%, rgba(var(--color-accent-rgb), 0.3), transparent 65%);
  }

  .collection-card__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 1.2s var(--ease);
  }

  .collection-card:hover .collection-card__media img {
    transform: scale(1.04);
  }

  .collection-card__content {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 4px 24px 24px;
  }

  .collection-card__content h2 {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .collection-card__count {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Collections"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}
