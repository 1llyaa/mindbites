{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<div class="section section--page-top product-main">
  {%- render 'product-gallery', product: product, eager: true -%}

  {%- render 'product-buybox',
    product: product,
    id: section.id,
    eyebrow: section.settings.eyebrow,
    title_tag: 'h1',
    show_description: section.settings.show_description,
    show_dynamic_checkout: section.settings.show_dynamic_checkout,
    update_url: true,
    perk_1: section.settings.perk_1,
    perk_2: section.settings.perk_2,
    perk_3: section.settings.perk_3
  -%}
</div>

{% stylesheet %}
  .product-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }

  @media (max-width: 860px) {
    .product-main {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Microdosed nootropic gummies"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:labels.show_description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "t:labels.show_dynamic_checkout",
      "default": true
    },
    {
      "type": "header",
      "content": "t:labels.perks"
    },
    {
      "type": "text",
      "id": "perk_1",
      "label": "t:labels.perk_1",
      "default": "Fast EU shipping"
    },
    {
      "type": "text",
      "id": "perk_2",
      "label": "t:labels.perk_2",
      "default": "Lab-tested, GMP-certified production"
    },
    {
      "type": "text",
      "id": "perk_3",
      "label": "t:labels.perk_3",
      "default": "Made in the EU"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
