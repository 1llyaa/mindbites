{% comment %}
  This section is used in the 404 template to render page shown when customers
  enter an invalid store URL.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

<div class="section not-found">
  <div class="not-found__inner">
    <p class="eyebrow">{{ '404.eyebrow' | t }}</p>
    <h1 class="not-found__code"><span class="chrome heavy">404</span></h1>
    <p class="spaced">{{ '404.not_found' | t }}</p>
    <div class="not-found__actions">
      <a class="btn" href="{{ routes.all_products_collection_url }}">
        {{- '404.back_to_shopping' | t -}}
        <span class="ar">{% render 'icon', name: 'arrow' %}</span>
      </a>
      <a class="btn btn--ghost" href="{{ routes.root_url }}">{{ '404.home' | t }}</a>
    </div>
  </div>
</div>

{% stylesheet %}
  .not-found__inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 24px;
    min-height: 60svh;
    align-content: center;
    text-align: center;
  }

  .not-found__inner::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(80vw, 640px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(var(--color-accent-rgb), 0.35), transparent 65%);
    filter: blur(30px);
    z-index: -1;
  }

  .not-found__code {
    font-size: clamp(6rem, 22vw, 16rem);
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.404",
  "settings": []
}
{% endschema %}
