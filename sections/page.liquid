{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<div class="section section--page-top main-page main-page--{{ section.settings.width }}">
  {%- if section.settings.show_title -%}
    <div class="section-head reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="display-l"><span class="chrome heavy">{{ page.title | escape }}</span></h1>
    </div>
  {%- endif -%}

  {%- if page.content != blank -%}
    <div class="main-page__content rte">{{ page.content }}</div>
  {%- endif -%}
</div>

{% stylesheet %}
  .main-page--narrow > * {
    max-width: 760px;
  }

  .main-page--narrow.main-page {
    justify-items: start;
  }

  .main-page__content {
    font-size: 1.05rem;
  }

  .main-page:not(:has(.main-page__content)) {
    padding-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "t:labels.show_title",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:labels.page_width",
      "options": [
        { "value": "narrow", "label": "t:options.page_width.narrow" },
        { "value": "wide", "label": "t:options.page_width.wide" }
      ],
      "default": "narrow"
    }
  ]
}
{% endschema %}
