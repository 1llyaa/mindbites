<div class="section trust-strip">
  {%- if section.settings.heading != blank -%}
    <p class="eyebrow trust-strip__heading">{{ section.settings.heading | escape }}</p>
  {%- endif -%}
  <div class="trust-strip__grid block-grid">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .trust-strip {
    padding-block: clamp(36px, 4.5vw, 56px);
  }

  .trust-strip__heading {
    text-align: center;
    margin-bottom: 28px;
  }

  .trust-strip__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
  }

  @media (max-width: 460px) {
    .trust-strip__grid {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.trust_strip",
  "blocks": [{ "type": "_trust-item" }],
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    }
  ],
  "presets": [
    {
      "name": "t:names.trust_strip",
      "blocks": {
        "gmp": { "type": "_trust-item", "settings": { "badge": "GMP", "label": "GMP certified" } },
        "haccp": { "type": "_trust-item", "settings": { "badge": "HACCP", "label": "HACCP" } },
        "eu": { "type": "_trust-item", "settings": { "badge": "EU", "label": "Made in the EU" } },
        "lab": { "type": "_trust-item", "settings": { "badge": "LAB", "label": "Lab tested" } }
      },
      "block_order": ["gmp", "haccp", "eu", "lab"]
    }
  ]
}
{% endschema %}
