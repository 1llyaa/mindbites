{% comment %}
  This section is used in the search template to render search results for
  products, articles, and pages.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

<div class="section section--page-top search-page">
  <div class="section-head">
    <p class="eyebrow">{{ 'search.eyebrow' | t }}</p>
    <h1 class="display-l"><span class="chrome heavy">{{ 'search.title' | t }}</span></h1>
  </div>

  <form class="search-page__form" action="{{ routes.search_url }}" method="get" role="search">
    <label class="visually-hidden" for="SearchPage-q">{{ 'search.placeholder' | t }}</label>
    <input
      class="input"
      id="SearchPage-q"
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'search.placeholder' | t }}"
      autocomplete="off"
    >
    <button class="btn" type="submit">
      {{- 'search.submit' | t -}}
      <span class="ar">{% render 'icon', name: 'search' %}</span>
    </button>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <p class="search-page__status">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
    {%- else -%}
      <p class="search-page__status">
        {{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}
      </p>

      {%- paginate search.results by 24 -%}
        <div class="product-grid">
          {%- for result in search.results -%}
            {%- case result.object_type -%}
              {%- when 'product' -%}
                {%- render 'product-card', product: result, heading_tag: 'h2' -%}
              {%- when 'article' -%}
                {%- render 'article-card', article: result -%}
              {%- else -%}
                <a class="search-page__page gcard reveal" href="{{ result.url }}">
                  <span class="eyebrow">{{ 'search.page' | t }}</span>
                  <h2>{{ result.title | escape }}</h2>
                  <p>{{ result.content | strip_html | truncatewords: 24 }}</p>
                </a>
            {%- endcase -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination }}</nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  {%- endif -%}
</div>

{% stylesheet %}
  .search-page__form {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 680px;
    margin-bottom: 32px;
  }

  .search-page__form .input {
    min-height: 62px;
    padding-right: 160px;
    border-radius: 999px;
    font-size: 1.05rem;
  }

  .search-page__form .btn {
    position: absolute;
    right: 4px;
  }

  .search-page__status {
    color: var(--color-muted);
    margin-bottom: 32px;
  }

  .search-page__page {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 28px;
    text-decoration: none;
  }

  .search-page__page h2 {
    font-size: 1.3rem;
    text-transform: none;
    letter-spacing: -0.01em;
  }

  .search-page__page p {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  @media (max-width: 480px) {
    .search-page__form {
      display: grid;
      gap: 10px;
    }

    .search-page__form .input {
      padding-right: 18px;
    }

    .search-page__form .btn {
      position: static;
      justify-content: space-between;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
