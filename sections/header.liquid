{%- liquid
  assign menu = section.settings.menu
  assign cart_drawer = false
  if settings.cart_type == 'drawer'
    assign cart_drawer = true
  endif
-%}

<header class="site-header full-width">
  <div class="site-header__bar content-grid">
    <div class="site-header__inner">
      {%- if menu.links.size > 0 -%}
        <details class="mobile-menu" data-menu scroll-lock>
          <summary class="mobile-menu__toggle" aria-label="{{ 'header.menu' | t }}">
            <i></i><i></i>
          </summary>
          <div class="mobile-menu__panel">
            <nav aria-label="{{ 'header.menu' | t }}">
              <ol>
                {%- for link in menu.links -%}
                  <li style="--i: {{ forloop.index }}">
                    <a
                      href="{{ link.url }}"
                      {% if link.active %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{- link.title | escape -}}
                    </a>
                  </li>
                {%- endfor -%}
              </ol>
            </nav>
            {%- if section.settings.cta_label != blank -%}
              <a class="btn btn--block" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
                {{- section.settings.cta_label | escape -}}
                <span class="ar">{% render 'icon', name: 'arrow' %}</span>
              </a>
            {%- endif -%}
          </div>
        </details>
      {%- endif -%}

      <a class="site-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {%- render 'logo', class: 'site-header__logo' -%}
      </a>

      {%- if menu.links.size > 0 -%}
        <nav class="site-header__nav" aria-label="{{ 'header.menu' | t }}">
          <ul>
            {%- for link in menu.links -%}
              <li>
                <a
                  href="{{ link.url }}"
                  {% if link.active %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      <div class="site-header__actions">
        {%- if section.settings.show_search -%}
          <a class="site-header__icon" href="{{ routes.search_url }}" aria-label="{{ 'search.title' | t }}">
            {%- render 'icon', name: 'search' -%}
          </a>
        {%- endif -%}

        {%- if shop.customer_accounts_enabled -%}
          <shopify-account class="site-header__icon" menu="{{ section.settings.customer_account_menu }}">
            {%- render 'icon', name: 'account' -%}
          </shopify-account>
        {%- endif -%}

        {%- unless settings.store_mode == 'edge_list' -%}
        <a
          class="site-header__icon site-header__cart"
          href="{{ routes.cart_url }}"
          aria-label="{{ 'cart.title' | t }}"
          {% if cart_drawer %}
            data-cart-trigger
          {% endif %}
        >
          {%- render 'icon', name: 'cart' -%}
          <span
            class="site-header__count"
            data-cart-count
            {% if cart.item_count == 0 %}
              hidden
            {% endif %}
          >
            {{- cart.item_count -}}
          </span>
        </a>
        {%- endunless -%}

        {%- if section.settings.cta_label != blank -%}
          <a class="btn btn--sm site-header__cta" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
            {{- section.settings.cta_label | escape -}}
            <span class="ar">{% render 'icon', name: 'arrow' %}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</header>

{% stylesheet %}
  .shopify-section:has(> .site-header) {
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .site-header__bar {
    position: relative;
    isolation: isolate;
    border-bottom: 1px solid rgba(var(--color-accent-rgb), 0.14);
  }

  /* Blur lives on a pseudo-element: backdrop-filter on the bar itself would trap the fixed mobile panel */
  .site-header__bar::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(5, 4, 7, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    height: var(--header-height);
  }

  .site-header__brand {
    justify-self: start;
  }

  .site-header__actions {
    grid-column: -2;
    justify-self: end;
  }

  .site-header__brand {
    display: block;
    flex: none;
  }

  .site-header__logo {
    height: var(--logo-height);
    width: auto;
  }

  .site-header__nav ul {
    display: flex;
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    text-decoration: none;
    font-size: 0.76rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
    transition: color 0.2s;
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current] {
    color: var(--color-foreground);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .site-header__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--color-foreground);
    text-decoration: none;
    transition: background-color 0.25s;
  }

  .site-header__icon:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .site-header__count {
    position: absolute;
    top: 3px;
    right: 1px;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    font-size: 0.65rem;
    font-weight: 600;
    line-height: 1;
    color: #fff;
    background: var(--color-accent);
    box-shadow: 0 0 10px rgba(var(--color-accent-rgb), 0.9);
  }

  .site-header__count[hidden] {
    display: none;
  }

  .site-header__cta {
    margin-left: 8px;
  }

  /* Mobile menu */
  .mobile-menu {
    display: none;
  }

  .mobile-menu__toggle {
    list-style: none;
    position: relative;
    z-index: 2;
    display: block;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.03);
    cursor: pointer;
  }

  .mobile-menu__toggle::-webkit-details-marker {
    display: none;
  }

  .mobile-menu__toggle i {
    position: absolute;
    left: 12px;
    right: 12px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--color-foreground);
    transition: transform 0.45s var(--ease), top 0.45s var(--ease);
  }

  .mobile-menu__toggle i:nth-child(1) {
    top: 16px;
  }

  .mobile-menu__toggle i:nth-child(2) {
    top: 22px;
  }

  .mobile-menu[open] .mobile-menu__toggle i:nth-child(1) {
    top: 19px;
    transform: rotate(45deg);
  }

  .mobile-menu[open] .mobile-menu__toggle i:nth-child(2) {
    top: 19px;
    transform: rotate(-45deg);
  }

  .mobile-menu__panel {
    position: fixed;
    inset: var(--menu-top, var(--header-height)) 0 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    padding: 32px var(--gutter) calc(32px + env(safe-area-inset-bottom, 0px));
    background: radial-gradient(70% 50% at 20% 10%, rgba(var(--color-accent-rgb), 0.28), transparent 70%),
      rgba(5, 4, 7, 0.96);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    overflow-y: auto;
    animation: menu-fade 0.35s ease both;
  }

  .mobile-menu__panel ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .mobile-menu__panel li {
    border-bottom: 1px solid var(--color-hairline);
    animation: menu-rise 0.5s var(--ease) both;
    animation-delay: calc(var(--i) * 0.05s);
  }

  .mobile-menu__panel li a {
    display: block;
    padding: 18px 0;
    font-size: clamp(1.4rem, 6.4vw, 2rem);
    font-weight: 300;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .mobile-menu__panel li a[aria-current] {
    color: var(--color-accent-light);
  }

  @keyframes menu-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes menu-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @media (max-width: 900px) {
    .site-header__nav,
    .site-header__cta {
      display: none;
    }

    .site-header__inner {
      grid-template-columns: auto 1fr auto;
    }

    .mobile-menu {
      display: block;
    }
  }

  @media (max-width: 760px) {
    .site-header__logo {
      height: calc(var(--logo-height) * 0.85);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:labels.show_search",
      "default": true
    },
    {
      "type": "header",
      "content": "t:labels.button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:labels.button_label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:labels.button_link"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
