[
  {
    "name": "theme_info",
    "theme_name": "MindBites",
    "theme_version": "1.0.0",
    "theme_author": "MindBites",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:labels.logo",
        "info": "t:info.logo"
      },
      {
        "type": "range",
        "id": "logo_height",
        "min": 16,
        "max": 40,
        "step": 1,
        "unit": "px",
        "label": "t:labels.logo_height",
        "default": 24
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon"
      },
      {
        "type": "text",
        "id": "tagline",
        "label": "t:labels.tagline",
        "default": "Taste the edge."
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "inter_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "77.5rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "90rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "77.5rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#050407",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "panel_color",
        "default": "#0c0a12",
        "label": "t:labels.panel"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#f1eff6",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "muted_color",
        "default": "#a29db0",
        "label": "t:labels.muted"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#623d90",
        "label": "t:labels.accent"
      },
      {
        "type": "color",
        "id": "accent_light_color",
        "default": "#a588c9",
        "label": "t:labels.accent_light"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 16,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 12
      }
    ]
  },
  {
    "name": "t:general.social",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram",
        "label": "t:labels.instagram"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "t:labels.tiktok"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "t:labels.facebook"
      }
    ]
  },
  {
    "name": "t:general.cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "t:labels.cart_type",
        "options": [
          { "value": "drawer", "label": "t:options.cart_type.drawer" },
          { "value": "page", "label": "t:options.cart_type.page" }
        ],
        "default": "drawer"
      }
    ]
  }
]
