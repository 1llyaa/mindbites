{% doc %}
  Renders an inline SVG icon. Brand icons (boost, sustain, focus, hex) are
  stroked with the shared `#mb-metal` gradient defined in the theme layout.

  @param {string} name - Icon name: arrow, cart, search, account, close, plus, minus, chevron, check, boost, sustain, focus, hex, brain, instagram, tiktok, facebook, mail, truck, shield, leaf
  @param {string} [class] - Optional class added to the SVG

  @example
  {% render 'icon', name: 'arrow' %}
  {% render 'icon', name: 'boost', class: 'effect__icon' %}
{% enddoc %}

{%- case name -%}
  {%- when 'arrow' -%}
    <svg class="{{ class }}" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'cart' -%}
    <svg class="icon {{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 8h14l-1.2 11.1a2 2 0 0 1-2 1.9H8.2a2 2 0 0 1-2-1.9L5 8Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M9 10V7a3 3 0 0 1 6 0v3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  {%- when 'search' -%}
    <svg class="icon {{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m16 16 4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  {%- when 'account' -%}
    <svg class="icon {{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8.5" r="3.75" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M4.75 20c.9-3.6 3.8-5.5 7.25-5.5s6.35 1.9 7.25 5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  {%- when 'close' -%}
    <svg class="icon {{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  {%- when 'plus' -%}
    <svg class="icon {{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  {%- when 'minus' -%}
    <svg class="icon {{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  {%- when 'chevron' -%}
    <svg class="icon {{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'check' -%}
    <svg class="icon {{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'mail' -%}
    <svg class="icon {{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.75" y="5.75" width="16.5" height="12.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m4.5 7 7.5 6 7.5-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
  {%- when 'truck' -%}
    <svg class="icon {{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6.75h11v9.5H3zM14 10h3.6l3.4 3.4v2.85H14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="7" cy="17.5" r="1.75" fill="var(--color-background)" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="17.5" r="1.75" fill="var(--color-background)" stroke="currentColor" stroke-width="1.5"/></svg>
  {%- when 'shield' -%}
    <svg class="icon {{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3.5 19 6v5.5c0 4.3-3 7.6-7 9-4-1.4-7-4.7-7-9V6l7-2.5Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="m9 12 2.2 2.2L15.5 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'leaf' -%}
    <svg class="icon {{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 19c0-8 5-13.5 14-14 .5 9-5 14-12.5 14H5Zm0 0 7-7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'boost' -%}
    <svg class="brand-icon brand-icon--boost {{ class }}" viewBox="12 9 60 60" aria-hidden="true" focusable="false"><g fill="none" stroke="url(#mb-metal)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path class="c1" d="M20 38 42 18l22 20"/><path class="c2" d="M20 60 42 40l22 20"/></g></svg>
  {%- when 'sustain' -%}
    <svg class="brand-icon brand-icon--sustain {{ class }}" viewBox="5 5 74 74" aria-hidden="true" focusable="false"><g fill="none" stroke-width="2.6" stroke-linecap="round"><path class="base" stroke="url(#mb-metal)" d="M42 42c-7-9-12-14-19-14a14 14 0 1 0 0 28c7 0 12-5 19-14s12-14 19-14a14 14 0 1 1 0 28c-7 0-12-5-19-14z"/><path class="trace" stroke="#efe6fa" d="M42 42c-7-9-12-14-19-14a14 14 0 1 0 0 28c7 0 12-5 19-14s12-14 19-14a14 14 0 1 1 0 28c-7 0-12-5-19-14z"/></g></svg>
  {%- when 'focus' -%}
    <svg class="brand-icon brand-icon--focus {{ class }}" viewBox="14 14 56 56" aria-hidden="true" focusable="false"><circle cx="42" cy="42" r="22" fill="none" stroke="url(#mb-metal)" stroke-width="2.2"/><circle class="ring" cx="42" cy="42" r="22" fill="none" stroke="var(--color-accent-light)" stroke-width="1.6"/></svg>
  {%- when 'hex' -%}
    <svg class="brand-icon brand-icon--hex {{ class }}" viewBox="0 0 80 80" aria-hidden="true" focusable="false"><path d="M40 3 72 21.5v37L40 77 8 58.5v-37z" fill="none" stroke="url(#mb-metal)" stroke-width="2.2" stroke-linejoin="round"/></svg>
  {%- when 'brain' -%}
    <svg class="brand-icon {{ class }}" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M24 2 43 13v22L24 46 5 35V13z" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M23 14c-2.5-1.8-6-.6-6.4 2.4-2.6.4-3.8 3.4-2.3 5.4-1.8 1.6-1.4 4.6.8 5.6-.4 2.8 2.4 5 5 4 1.4 1.8 3.6 1.6 2.9 0zM25 14c2.5-1.8 6-.6 6.4 2.4 2.6.4 3.8 3.4 2.3 5.4 1.8 1.6 1.4 4.6-.8 5.6.4 2.8-2.4 5-5 4-1.4 1.8-3.6 1.6-2.9 0zM19 20c1.5.4 2.5 1.6 2.4 3M29 20c-1.5.4-2.5 1.6-2.4 3M19.5 27.5c1.3-.6 2.3-.3 3 .6M28.5 27.5c-1.3-.6-2.3-.3-3 .6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'instagram' -%}
    <svg class="icon {{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.75" y="3.75" width="16.5" height="16.5" rx="4.5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="3.75" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor"/></svg>
  {%- when 'tiktok' -%}
    <svg class="icon {{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14 3.75v11.5a3.25 3.25 0 1 1-3.25-3.25M14 3.75c.4 2.6 2.1 4.2 4.75 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'facebook' -%}
    <svg class="icon {{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13.5 20.25v-7.5h2.6l.4-3h-3V8c0-.9.3-1.5 1.6-1.5h1.5V3.9c-.3 0-1.2-.15-2.2-.15-2.2 0-3.7 1.35-3.7 3.8v2.2H8.25v3h2.45v7.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
{%- endcase -%}
