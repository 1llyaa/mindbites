{% doc %}
  Renders the product media as a swipeable gallery with thumbnails. Falls back
  to the bundled pouch packshot when the product has no images.

  @param {object} product - The product whose media is shown
  @param {boolean} [eager] - Load the first image eagerly (above the fold)

  @example
  {% render 'product-gallery', product: product, eager: true %}
{% enddoc %}

{%- assign images = product.media | where: 'media_type', 'image' -%}

<media-gallery class="gallery">
  <div class="gallery__glow" aria-hidden="true"></div>
  <ul class="gallery__track" role="list" data-gallery-track>
    {%- for media in images -%}
      <li class="gallery__slide" id="Slide-{{ media.id }}">
        {%- liquid
          assign loading = 'lazy'
          if eager and forloop.first
            assign loading = 'eager'
          endif
        -%}
        {{
          media.preview_image
          | image_url: width: 1400
          | image_tag:
            widths: '480, 720, 960, 1200, 1400',
            sizes: '(min-width: 900px) 50vw, 100vw',
            loading: loading,
            alt: media.alt
        }}
      </li>
    {%- else -%}
      <li class="gallery__slide">
        <img
          src="{{ 'mb-hero-pouch.webp' | asset_url }}"
          alt="{{ product.title | escape }}"
          width="1600"
          height="2000"
        >
      </li>
    {%- endfor -%}
  </ul>

  {%- if images.size > 1 -%}
    <div class="gallery__thumbs">
      {%- for media in images -%}
        <button
          type="button"
          class="gallery__thumb"
          data-index="{{ forloop.index0 }}"
          aria-label="{{ 'products.show_image' | t: index: forloop.index }}"
          {% if forloop.first %}
            aria-current="true"
          {% endif %}
        >
          {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</media-gallery>

{% stylesheet %}
  .gallery {
    position: relative;
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .gallery__glow {
    position: absolute;
    left: 50%;
    top: 42%;
    width: 80%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(var(--color-accent-rgb), 0.4), transparent 65%);
    filter: blur(30px);
    pointer-events: none;
  }

  .gallery__track {
    position: relative;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    list-style: none;
    margin: 0;
    padding: 0;
    border-radius: 16px;
    border: 1px solid var(--color-hairline);
    background: rgba(255, 255, 255, 0.02);
  }

  .gallery__track::-webkit-scrollbar {
    display: none;
  }

  .gallery__slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    padding: clamp(16px, 4vw, 48px);
  }

  .gallery__slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 30px 50px rgba(0, 0, 0, 0.6));
  }

  .gallery__thumbs {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .gallery__thumb {
    flex: none;
    width: 72px;
    aspect-ratio: 1;
    padding: 6px;
    border-radius: 12px;
    border: 1px solid var(--color-hairline);
    background: rgba(255, 255, 255, 0.03);
    cursor: pointer;
    transition: border-color 0.25s;
  }

  .gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .gallery__thumb[aria-current='true'] {
    border-color: var(--color-accent-light);
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('media-gallery')) {
    customElements.define(
      'media-gallery',
      class MediaGallery extends HTMLElement {
        connectedCallback() {
          this.track = this.querySelector('[data-gallery-track]');
          this.thumbs = [...this.querySelectorAll('.gallery__thumb')];
          if (!this.thumbs.length) return;

          this.thumbs.forEach((thumb) =>
            thumb.addEventListener('click', () => {
              const index = Number(thumb.dataset.index);
              this.track.scrollTo({ left: this.track.clientWidth * index, behavior: 'smooth' });
            })
          );

          this.track.addEventListener(
            'scroll',
            () => {
              const index = Math.round(this.track.scrollLeft / this.track.clientWidth);
              this.thumbs.forEach((thumb, i) => thumb.setAttribute('aria-current', String(i === index)));
            },
            { passive: true }
          );
        }
      }
    );
  }
{% endjavascript %}
