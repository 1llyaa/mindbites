<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'css-variables' %}

    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% render 'favicon' %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {% # Shared gradient used to stroke the brand line icons %}
    <svg width="0" height="0" style="position: absolute" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="mb-metal" gradientUnits="userSpaceOnUse" x1="0" y1="14" x2="0" y2="72">
          <stop offset="0" stop-color="#c7aef0"/>
          <stop offset=".55" stop-color="#8c62c4"/>
          <stop offset="1" stop-color="{{ settings.accent_color }}"/>
        </linearGradient>
      </defs>
    </svg>

    {{ content_for_layout }}
  </body>
</html>
